{
  "mcpServers": {
    "wp-devdocs": {
      "command": "npx",
      "args": ["wp-devdocs-mcp"]
    },
    "wp-blockmarkup": {
      "command": "npx",
      "args": ["wp-blockmarkup-mcp"]
    },
    "wp-playground": {
      "command": "npx",
      "args": ["wp-playground-mcp"]
    },
    "github": {
