<?xml version="1.0"?>
<ruleset name="pl-example">
    <description>Coding standards for pl-example.</description>

    <file>.</file>
    <exclude-pattern>vendor/</exclude-pattern>
    <exclude-pattern>node_modules/</exclude-pattern>
    <exclude-pattern>build/</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="WordPress"/>
    <rule ref="PHPCompatibilityWP"/>

    <!-- The main plugin file is an entry point that carries the plugin header
         and a small bootstrap class; the class-file-naming rule targets
         includes/, not the entry file. -->
    <rule ref="WordPress.Files.FileName.InvalidClassFileName">
        <exclude-pattern>pl-example.php</exclude-pattern>
    </rule>

    <config name="minimum_supported_wp_version" value="6.7"/>
    <config name="testVersion" value="8.2-"/>
</ruleset>
